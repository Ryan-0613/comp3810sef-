<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <title>StudyManager - Sign Up</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }
        body {
            background-image: url('https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: rgba(0,0,0,0.45);
            background-blend-mode: darken;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin:0;
        }
        .box{
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(8px);
            padding:34px;
            border-radius:16px;
            width:380px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.25);
        }
        h1 {
            text-align: center;
            color: #2c3e50;
            margin-top:0;
            font-size:24px;
        }
        .error{
            color:#e74c3c;
            text-align:center;
            font-weight:500;
        }
        label {
            display:block;
            margin-bottom:6px;
            color:#34495e;
            font-size:14px;
        }
        input {
            width:100%;
            padding:10px 12px;
            border:1px solid #cbd5e0;
            border-radius:8px;
            font-size:15px;
        }
        input:focus {
            outline:none;
            border-color:#3498db;
            box-shadow: 0 0 0 3px rgba(52,152,219,0.2);
        }
        .form-group {
            margin-top:14px;
        }
        button {
            margin-top:20px;
            width:100%;
            padding:11px;
            background-color:#2980b9;
            color:white;
            border:none;
            border-radius:8px;
            font-size:16px;
            cursor:pointer;
            transition: background 0.2s;
        }
        button:hover {
            background-color:#1f618d;
        }
        p {
            text-align:center;
            margin-top:18px;
            color:#444;
            font-size:14px;
        }
        a {
            color:#2980b9;
            text-decoration:none;
            font-weight:500;
        }
        a:hover {
            text-decoration:underline;
        }
    </style>
</head>
<body>
    <div class="box">
        <h1>StudyManager - Sign Up</h1>
        <% if (typeof err !== 'undefined' && err) { %>
            <p class="error"><%= err %></p>
        <% } %>
        <form method="POST" action="/register">
            <div class="form-group">
                <label>Account (3–16 characters, letters, numbers, underscores _)</label>
                <input 
                    type="text" 
                    name="username" 
                    required
                    pattern="[a-zA-Z0-9_]{3,16}"
                    title="The account name must be 3–16 characters long and can only use letters, numbers, and underscores_."
                >
            </div>
            <div class="form-group">
                <label>Password (Must be 8 characters or more, including uppercase, lowercase, and numbers)</label>
                <input 
                    type="password" 
                    name="password" 
                    required
                    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$"
                    title="The password must be 8 characters or more, including uppercase, lowercase, and numbers"
                >
            </div>
            <button type="submit">Sign Up</button>
        </form>
        <p>Already have an account? <a href="/login">Sign In</a></p>
    </div>
</body>
</html>



