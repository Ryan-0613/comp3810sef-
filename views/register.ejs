<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <title>StudyManager - Sign Up</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-image: url('https://images.unsplash.com/photo-1456513080510-7bf3a84b82f8?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: rgba(0,0,0,0.4);
            background-blend-mode: darken;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 98vh;
            margin:0;
        }
        .box{
            background:white;
            padding:30px;
            border-radius:12px;
            width:350px;
        }
        .error{
            color:red;
        }
    </style>
</head>
<body>
    <div class="box">
        <h1>SStudyManager - Sign Up</h1>
        <% if (err) { %>
            <p class="error"><%= err %></p>
        <% } %>
        <form method="POST" action="/register">
            <div>
                <label>Account (3–16 characters, letters, numbers, underscores _)</label>
                <input 
                    type="text" 
                    name="username" 
                    required
                    pattern="[a-zA-Z0-9_]{3,16}"
                    title="The account name must be 3–16 characters long and can only use letters, numbers, and underscores_."
                >
            </div>
            <div style="margin-top:10px;">
                <label>Password (Must be 8 characters or more, including uppercase, lowercase, and numbers)</label>
                <input 
                    type="password" 
                    name="password" 
                    required
                    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$"
                    title="The password must be 8 characters or more, including uppercase, lowercase, and numbers"
                >
            </div>
            <button type="submit" style="margin-top:15px;width:100%;padding:8px;">Sign Up</button>
        </form>
        <p>Already have an account?<a href="/login">Sign In</a></p>
    </div>
</body>
</html>

